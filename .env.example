# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Tahap 2 - Backend & Realtime Adapter)
# Jangan menanam service_role key di frontend. Gunakan anon key dengan Row Level Security (RLS).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_APP_ENV="demo"
